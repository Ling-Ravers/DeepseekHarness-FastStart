{
  "name": "dsh-open-in-dsh",
  "description": "DeepSeek Harness Windows shell integration: an \u201cOpen in DSH\u201d folder context menu that starts or enters DSH with the folder as its workspace, backed by a system tray and a quick-open settings card",
  "version": "0.1.0-alpha.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ling-Ravers/DeepseekHarness-FastStart.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "assets/**"
  ],
  "scripts": {
    "bundle": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "windows",
    "shell-integration",
    "context-menu",
    "tray"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.8"
  }
}
